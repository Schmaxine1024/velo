#
# Standard Pebble build rules, with one change from the stock file: the JS
# bundle is optional. Velo's companion is a native Android app talking over
# PebbleKit's intent API, so there is no src/pkjs directory and passing an
# empty js glob to pbl_bundle is an error rather than a no-op.
#

import os
import os.path

top = '.'
out = 'build'


def options(ctx):
    ctx.load('pebble_sdk')


def configure(ctx):
    ctx.load('pebble_sdk')


def build(ctx):
    ctx.load('pebble_sdk')

    build_worker = os.path.exists('worker_src')
    binaries = []

    # `VELO_DEMO=1 pebble build` compiles in a synthetic telemetry source so
    # the screens can be driven in the emulator, which has no companion app and
    # therefore no AppMessages at all. Off by default; see README.
    #
    # Applied here rather than in configure() because each target platform gets
    # its own env: a DEFINE set on the base env during configure never reaches
    # the per-platform compiles, and the flag silently does nothing.
    demo = bool(os.environ.get('VELO_DEMO'))

    for platform in ctx.env.TARGET_PLATFORMS:
        ctx.set_env(ctx.all_envs[platform])
        ctx.set_group(ctx.env.PLATFORM_NAME)
        if demo:
            ctx.env.append_value('DEFINES', 'VELO_DEMO')
        app_elf = '{}/pebble-app.elf'.format(ctx.env.BUILD_DIR)
        ctx.pbl_program(source=ctx.path.ant_glob('src/c/**/*.c'), target=app_elf)

        if build_worker:
            worker_elf = '{}/pebble-worker.elf'.format(ctx.env.BUILD_DIR)
            binaries.append({'platform': platform,
                             'app_elf': app_elf,
                             'worker_elf': worker_elf})
            ctx.pbl_worker(source=ctx.path.ant_glob('worker_src/c/**/*.c'),
                           target=worker_elf)
        else:
            binaries.append({'platform': platform, 'app_elf': app_elf})

    ctx.set_group('bundle')

    js_files = ctx.path.ant_glob(['src/pkjs/**/*.js', 'src/pkjs/**/*.json'])
    if js_files:
        ctx.pbl_bundle(binaries=binaries,
                       js=js_files,
                       js_entry_file='src/pkjs/index.js')
    else:
        ctx.pbl_bundle(binaries=binaries)
